{
  "name": "pokesurvivor-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Port a app nativa de Android (Capacitor) del juego PokeSurvivor (JPTER78/pokesurvivor).",
  "scripts": {
    "sync": "cap sync android",
    "open:android": "cap open android",
    "build:web": "node www/tools/build.js --sin-seo",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "assets:prepare": "node scripts/prepare-assets.js",
    "postinstall": "npm run assets:prepare",
    "presync": "npm run assets:prepare",
    "prebuild:web": "npm run assets:prepare",
    "assets:verify": "node scripts/verify-assets.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/offline-browser.cjs",
    "test:audio": "node tests/audio-browser.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "playwright": "1.64.1"
  }
}
